<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: FSL-1.1-ALv2 -->
<!-- Cucina profile 03: Managed Login Items (macOS 13+, MDM-only, cannot be installed by hand). The private certificate has no Team ID, so the rule matches the launchd Label of the hostd LaunchDaemon. Apple Business can express the same rule in the package's "Add Items" (Service Label). -->
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>Rules</key>
			<array>
				<dict>
					<key>Comment</key>
					<string>cucina-hostd LaunchDaemon (Cucina host agent)</string>
					<key>RuleType</key>
					<string>Label</string>
					<key>RuleValue</key>
					<string>ai.sloper.cucina.hostd</string>
				</dict>
			</array>
			<key>PayloadDisplayName</key>
			<string>Cucina managed login items</string>
			<key>PayloadIdentifier</key>
			<string>ai.sloper.cucina.profile.login-items.servicemanagement</string>
			<key>PayloadType</key>
			<string>com.apple.servicemanagement</string>
			<key>PayloadUUID</key>
			<string>F805C8F6-8B3E-4A4B-A356-D5E63329F127</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>Cucina: marks the cucina-hostd LaunchDaemon as managed so it cannot be disabled in Login Items.</string>
	<key>PayloadDisplayName</key>
	<string>Cucina 03 managed login items</string>
	<key>PayloadIdentifier</key>
	<string>ai.sloper.cucina.profile.login-items</string>
	<key>PayloadOrganization</key>
	<string>${CUCINA_ORGANIZATION}</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>ABCA8681-5935-4752-911D-5A6C68A7C8C5</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
