TART_URL=https://github.com/openai/tart/releases/download/2.40.1/tart.tar.gz
TART_SHA256=363e2701154a8155cbc1bb6d845430c9b42697d2a186bc49574471ca2877db46
# Code-signing facts of the released tart.app (verified on every build; a mismatch aborts the build).
TART_BUNDLE_ID=com.github.cirruslabs.tart
TART_TEAM_ID=9M2P8L4D89
TART_CDHASH=4529d978bbde86467644a71433838f216dd96fb0

