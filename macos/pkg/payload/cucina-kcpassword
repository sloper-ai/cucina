#!/usr/bin/perl
# SPDX-License-Identifier: FSL-1.1-ALv2
# Encode a password from stdin into macOS's kcpassword format on stdout (ADR 0755).
# This is reversible obfuscation, NOT encryption: /etc/kcpassword must be root:wheel 0600.
# No arguments, files, logging or subprocesses; the caller performs the atomic protected write.
use strict;
use warnings;
binmode STDIN;
binmode STDOUT;
local $/;
my $password = <STDIN>;
defined($password) && length($password) > 0 && length($password) <= 256
    && $password !~ /[\x00\r\n]/ or die "expected one nonempty password on stdin\n";
my $plain = $password . "\0";
$plain .= "\0" x ((12 - length($plain) % 12) % 12);
# Public macOS format mask, not a cryptographic key or a credential.
my $mask = pack('C*', 0x7d, 0x89, 0x52, 0x23, 0xd2, 0xbc, 0xdd, 0xea, 0xa3, 0xb9, 0x1f);
print $plain ^ substr($mask x (1 + int(length($plain) / length($mask))), 0, length($plain));
