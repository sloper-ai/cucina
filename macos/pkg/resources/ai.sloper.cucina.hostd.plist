<!-- cucina-hostd LaunchDaemon (R-MAC-1): root, starts at boot without a login, crash-only (launchd restarts it).
     Installed to /Library/LaunchDaemons/ai.sloper.cucina.hostd.plist (root:wheel 0644).
     Contract: docs/dev/hostd.md §2. ExitTimeOut gives hostd time to stop its VMs gracefully on upgrade/uninstall. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.sloper.cucina.hostd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/cucina/bin/cucina-hostd</string>
		<string>run</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ExitTimeOut</key>
	<integer>120</integer>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>65536</integer>
	</dict>
	<key>HardResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>65536</integer>
	</dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/cucina/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/Library/Logs/Cucina/hostd.stderr.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/Cucina/hostd.stderr.log</string>
</dict>
</plist>
