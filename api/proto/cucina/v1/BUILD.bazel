load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("//bazel:proto.bzl", "cucina_proto_go")

proto_library(
    name = "cucinav1_proto",
    srcs = [
        "common.proto",
        "enrollment.proto",
        "host.proto",
        "management.proto",
    ],
    strip_import_prefix = "/api/proto",
    visibility = ["//visibility:public"],
    deps = [
        "@protobuf//:duration_proto",
        "@protobuf//:timestamp_proto",
    ],
)

# The checked-in *.pb.go files (also produced by `buf generate`, see buf.gen.yaml)
# are regenerated by `bazel run //api/proto/cucina/v1:cucinav1_go`; the
# tier-static diff tests fail when they drift from the .proto files.
cucina_proto_go(
    name = "cucinav1_go",
    grpc = [
        "enrollment.proto",
        "host.proto",
        "management.proto",
    ],
    importpath = "github.com/sloper-ai/cucina/api/proto/cucina/v1",
    proto = ":cucinav1_proto",
)

go_library(
    name = "cucina",
    srcs = [
        "common.pb.go",
        "enrollment.pb.go",
        "enrollment_grpc.pb.go",
        "host.pb.go",
        "host_grpc.pb.go",
        "management.pb.go",
        "management_grpc.pb.go",
    ],
    importpath = "github.com/sloper-ai/cucina/api/proto/cucina/v1",
    visibility = ["//visibility:public"],
    deps = [
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//runtime/protoimpl",
        "@org_golang_google_protobuf//types/known/durationpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
