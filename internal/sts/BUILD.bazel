load("@rules_go//go:def.bzl", "go_library")
load("//bazel:tiers.bzl", "cucina_go_test")

go_library(
    name = "sts",
    srcs = [
        "server.go",
        "support.go",
        "token.go",
    ],
    importpath = "github.com/sloper-ai/cucina/internal/sts",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/auth",
        "//internal/config",
        "//internal/keys",
        "//internal/ports",
        "@com_github_maypok86_otter_v2//:otter",
        "@com_github_prometheus_client_golang//prometheus",
    ],
)

cucina_go_test(
    name = "sts_test",
    srcs = [
        "buildbarn_test.go",
        "sts_test.go",
    ],
    data = [
        "//internal/auth:sample_policies",
        "//tools:bb_storage",
    ],
    env = {
        "BB_STORAGE": "$(rootpath //tools:bb_storage)",
    },
    tier = "integration",
    deps = [
        ":sts",
        "//api/v1alpha1",
        "//internal/auth",
        "//internal/auth/oidctest",
        "//internal/bbtest",
        "//internal/config",
        "//internal/keys",
        "//internal/keys/keystest",
        "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:execution",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_prometheus_client_golang//prometheus/testutil",
        "@com_github_prometheus_client_model//go",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_k8s_sigs_yaml//:yaml",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
    ],
)
