        "kube.go",
        "launch.go",
        "pkcs7.go",
        "ratelimit.go",
        "server.go",
        "store.go",
        "tokens.go",
        "worker.go",
    ],
    importpath = "github.com/sloper-ai/cucina/internal/enroll",
    visibility = ["//:__subpackages__"],
    deps = [
        "//api/proto/cucina/v1:cucina",
        "//api/v1alpha1",
        "//internal/domain",
        "//internal/pki",
        "//internal/ports",
        "//internal/proto",
        "//internal/scaling",
        "@com_github_maypok86_otter_v2//:otter",
