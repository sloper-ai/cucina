cucina_go_test(
    name = "enroll_test",
    timeout = "short",
    srcs = [
        "ec2iid_test.go",
        "helpers_test.go",
        "host_test.go",
        "kube_test.go",
        "server_test.go",
        "t10h_test.go",
        "worker_test.go",
    ],
    runfiles_env = {
        "BB_SCHEDULER": "//tools:bb_scheduler",
    },
    tier = "integration",  # gRPC over loopback TLS, the pinned bb_scheduler (T10 h)
    deps = [
        ":enroll",
        "//api/proto/cucina/v1:cucina",
        "//api/v1alpha1",
        "//internal/bbtest",
        "//internal/domain",
        "//internal/fakes",
        "//internal/pki",
        "//internal/pki/pkitest",
        "//internal/ports",
        "//internal/scaling",
        "@com_github_stretchr_testify//require",
        "@io_k8s_api//coordination/v1:coordination",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_client_go//kubernetes/scheme",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/client/fake",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//status",
