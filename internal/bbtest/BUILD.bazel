load("@rules_go//go:def.bzl", "go_library")
load("//bazel:tiers.bzl", "cucina_go_test")

go_library(
    name = "bbtest",
    testonly = True,
    srcs = [
        "binaries.go",
        "configs.go",
        "doc.go",
        "fakeworker.go",
        "nfsmount.go",
        "pki.go",
        "proc_unix.go",
        "proc_windows.go",
        "process.go",
        "reapi.go",
    ],
    importpath = "github.com/sloper-ai/cucina/internal/bbtest",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/ports",
        "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:execution",
        "@com_github_buildbarn_bb_remote_execution//pkg/proto/configuration/bb_scheduler",
        "@com_github_buildbarn_bb_remote_execution//pkg/proto/configuration/scheduler",
        "@com_github_buildbarn_bb_remote_execution//pkg/proto/remoteworker",
        "@com_github_buildbarn_bb_storage//pkg/proto/auth",
        "@com_github_buildbarn_bb_storage//pkg/proto/configuration/auth",
        "@com_github_buildbarn_bb_storage//pkg/proto/configuration/blobstore",
        "@com_github_buildbarn_bb_storage//pkg/proto/configuration/grpc",
        "@com_github_buildbarn_bb_storage//pkg/proto/configuration/jmespath",
        "@com_github_buildbarn_bb_storage//pkg/proto/configuration/tls",
        "@com_github_buildbarn_bb_storage//pkg/proto/configuration/x509",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//backoff",
        "@org_golang_google_grpc//connectivity",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/anypb",
        "@org_golang_google_protobuf//types/known/durationpb",
        "@org_golang_google_protobuf//types/known/emptypb",
    ],
)

cucina_go_test(
    name = "bbtest_test",
    timeout = "short",
    srcs = [
        "nfsmount_test.go",
        "process_test.go",
    ],
    embed = [":bbtest"],
    tier = "integration",
    deps = [
        "//internal/fakes",
        "//internal/ports",
        "@com_github_stretchr_testify//require",
    ],
)
