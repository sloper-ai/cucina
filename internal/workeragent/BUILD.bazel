        "paths.go",
        "placement.go",
        "power.go",
        "probe.go",
        "render.go",
        "selftest.go",
        "state.go",
        "storage.go",
        "supervise.go",
        "sysfs.go",
    ],
    importpath = "github.com/sloper-ai/cucina/internal/workeragent",
    visibility = ["//:__subpackages__"],
    deps = [
        "//api/proto/cucina/v1:cucina",
        "//internal/bbconfig",
        "//internal/domain",
        "//internal/ports",
        "//internal/proto",
        "//internal/workeragent/bootdata",
