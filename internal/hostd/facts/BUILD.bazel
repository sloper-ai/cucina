)

cucina_go_test(
    name = "facts_test",
    srcs = ["facts_test.go"],
    tier = "unit",
    deps = [
        ":facts",
        "//internal/fakes",
        "//internal/ports",
        "@com_github_stretchr_testify//require",
    ],
)
