load("@rules_go//go:def.bzl", "go_library")
load("//bazel:tiers.bzl", "cucina_go_test")

go_library(
    name = "facts",
    srcs = ["facts.go"],
    importpath = "github.com/sloper-ai/cucina/internal/hostd/facts",
    visibility = ["//:__subpackages__"],
    deps = [
        "//api/proto/cucina/v1:cucina",
        "//internal/ports",
