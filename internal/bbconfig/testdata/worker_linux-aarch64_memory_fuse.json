{
  "blobstore": {
    "contentAddressableStorage": {
      "readCaching": {
        "slow": {
          "grpc": {
            "client": {
              "address": "workers.cucina.example.com:8981",
              "tls": {
                "serverCertificateAuthorities": "-----BEGIN CERTIFICATE-----\nPLACEHOLDER-FOR-THE-CUCINA-CA-BUNDLE\n-----END CERTIFICATE-----\n",
                "serverName": "workers.cucina.example.com",
                "clientKeyPair": {
                  "files": {
                    "certificatePath": "/etc/cucina/pki/worker.crt",
                    "privateKeyPath": "/etc/cucina/pki/worker.key",
                    "refreshInterval": "300s"
                  }
                }
              }
            }
          }
        },
        "fast": {
          "local": {
            "keyLocationMapInMemory": {
              "entries": "524288"
            },
            "keyLocationMapMaximumGetAttempts": 16,
            "keyLocationMapMaximumPutAttempts": "64",
            "oldBlocks": 1,
            "currentBlocks": 2,
            "newBlocks": 1,
            "blocksInMemory": {
              "blockSizeBytes": "1073741824"
            }
          }
        },
        "replicator": {
          "deduplicating": {
            "concurrencyLimiting": {
              "base": {
                "local": {}
              },
              "maximumConcurrency": "32"
            }
          }
        }
      }
    },
    "actionCache": {
      "grpc": {
        "client": {
          "address": "workers.cucina.example.com:8981",
          "tls": {
            "serverCertificateAuthorities": "-----BEGIN CERTIFICATE-----\nPLACEHOLDER-FOR-THE-CUCINA-CA-BUNDLE\n-----END CERTIFICATE-----\n",
            "serverName": "workers.cucina.example.com",
            "clientKeyPair": {
              "files": {
                "certificatePath": "/etc/cucina/pki/worker.crt",
                "privateKeyPath": "/etc/cucina/pki/worker.key",
                "refreshInterval": "300s"
              }
            }
          }
        }
      }
    }
  },
  "maximumMessageSizeBytes": "16777216",
  "scheduler": {
    "address": "workers.cucina.example.com:8983",
    "tls": {
      "serverCertificateAuthorities": "-----BEGIN CERTIFICATE-----\nPLACEHOLDER-FOR-THE-CUCINA-CA-BUNDLE\n-----END CERTIFICATE-----\n",
      "serverName": "workers.cucina.example.com",
      "clientKeyPair": {
        "files": {
          "certificatePath": "/etc/cucina/pki/worker.crt",
          "privateKeyPath": "/etc/cucina/pki/worker.key",
          "refreshInterval": "300s"
        }
      }
    }
  },
  "global": {
    "diagnosticsHttpServer": {
      "httpServers": [
        {
          "listenAddresses": [
            ":9986"
          ],
          "authenticationPolicy": {
            "allow": {}
          }
        }
      ],
      "enablePrometheus": true
    }
  },
  "buildDirectories": [
    {
      "virtual": {
        "mount": {
          "mountPath": "/var/lib/cucina/build",
          "fuse": {
            "directoryEntryValidity": "300s",
            "inodeAttributeValidity": "300s",
            "allowOther": true,
            "mountMethod": "DIRECT_AND_FUSERMOUNT",
            "maximumBackgroundTasks": 1024
          }
        },
        "maximumExecutionTimeoutCompensation": "3600s",
        "maximumWritableFileUploadDelay": "60s"
      },
      "runners": [
        {
          "endpoint": {
            "address": "unix:///run/cucina/runner.sock"
          },
          "concurrency": "8",
          "instanceNamePrefix": "main",
          "platform": {
            "properties": [
              {
                "name": "ISA",
                "value": "arm-a64"
              },
              {
                "name": "OSFamily",
                "value": "linux"
              }
            ]
          },
          "sizeClass": 1,
          "maximumFilePoolFileCount": "100000",
          "maximumFilePoolSizeBytes": "4294967296",
          "workerId": {
            "node": "i-0fedcba9876543210",
            "pool": "linux-arm"
          },
          "buildDirectoryOwnerUserId": 2000,
          "buildDirectoryOwnerGroupId": 2000
        }
      ]
    }
  ],
  "filePool": {
    "blockDevice": {
      "file": {
        "path": "/var/lib/cucina/state/filepool/pool",
        "sizeBytes": "34359738368"
      }
    }
  },
  "outputUploadConcurrency": "16",
  "directoryCache": {
    "maximumCount": "10000",
    "maximumSizeBytes": "16777216",
    "cacheReplacementPolicy": "LEAST_RECENTLY_USED"
  },
  "prefetching": {
    "fileSystemAccessCache": {
      "grpc": {
        "client": {
          "address": "workers.cucina.example.com:8981",
          "tls": {
            "serverCertificateAuthorities": "-----BEGIN CERTIFICATE-----\nPLACEHOLDER-FOR-THE-CUCINA-CA-BUNDLE\n-----END CERTIFICATE-----\n",
            "serverName": "workers.cucina.example.com",
            "clientKeyPair": {
              "files": {
                "certificatePath": "/etc/cucina/pki/worker.crt",
                "privateKeyPath": "/etc/cucina/pki/worker.key",
                "refreshInterval": "300s"
              }
            }
          }
        }
      }
    },
    "bloomFilterBitsPerPath": 14,
    "bloomFilterMaximumSizeBytes": 65536
  },
  "inputDownloadConcurrency": "32"
}
