load("@rules_go//go:def.bzl", "go_library")
load("//bazel:tiers.bzl", "cucina_go_test")

go_library(
    name = "auth",
    srcs = [
        "cel.go",
        "doc.go",
        "engine.go",
        "errors.go",
        "groups.go",
        "interceptor.go",
        "oidc.go",
        "policy.go",
        "replay.go",
        "verbs.go",
    ],
    importpath = "github.com/sloper-ai/cucina/internal/auth",
    visibility = ["//:__subpackages__"],
    deps = [
        "//api/proto/cucina/v1:cucina",
        "//api/v1alpha1",
        "//internal/keys",
        "//internal/ports",
        "@com_github_coreos_go_oidc_v3//oidc",
        "@com_github_go_jose_go_jose_v4//:go-jose",
        "@com_github_maypok86_otter_v2//:otter",
        "@dev_cel_cel_go//cel",
        "@dev_cel_cel_go//common/types",
        "@dev_cel_cel_go//common/types/ref",
        "@dev_cel_cel_go//common/types/traits",
        "@dev_cel_cel_go//ext",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_x_oauth2//jwt",
    ],
)

cucina_go_test(
    name = "auth_test",
    srcs = [
        "engine_test.go",
        "groups_test.go",
        "interceptor_test.go",
        "property_test.go",
        "providers_test.go",
    ],
    data = glob(["testdata/**"]),
    tier = "unit",
    deps = [
        ":auth",
        "//api/v1alpha1",
        "//internal/auth/oidctest",
        "//internal/keys",
        "//internal/keys/keystest",
        "//internal/ports",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_sigs_yaml//:yaml",
        "@net_pgregory_rapid//:rapid",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
    ],
)

# Shipped TrustPolicy samples (docs/security.md §Trust policies); also read by the
# STS integration test.
filegroup(
    name = "sample_policies",
    srcs = glob(["testdata/policies/*.yaml"]),
    visibility = ["//internal/sts:__pkg__"],
)
