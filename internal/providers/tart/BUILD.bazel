load("@rules_go//go:def.bzl", "go_library")
load("//bazel:tiers.bzl", "cucina_go_test")

go_library(
    name = "tart",
    srcs = ["tart.go"],
    importpath = "github.com/sloper-ai/cucina/internal/providers/tart",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/ports"],
)

cucina_go_test(
    name = "tart_test",
    srcs = ["tart_test.go"],
    # VMRuntime conformance suite against the tart CLI emulator; the real-Tart run is acceptance (env-gated skip).
    tier = "integration",
    deps = [
        ":tart",
        "//internal/hostd/sys",
        "//internal/ports",
        "//internal/ports/porttest",
        "//internal/providers/tart/faketart",
        "@com_github_stretchr_testify//require",
    ],
)
