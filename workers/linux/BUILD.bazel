load("//bazel:tiers.bzl", "cucina_sh_test")

cucina_sh_test(
    name = "notices_test",
    srcs = ["tests/notices_test.sh"],
    data = ["scripts/install-notices.sh"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tier = "integration",
)

cucina_sh_test(
    name = "service_policy_test",
    timeout = "short",
    srcs = ["tests/service_policy_test.sh"],
    data = [
        "files/bin/cucina-bootstrap",
        "files/bin/cucina-worker-memory-policy",
        "files/systemd/bb-runner.service",
        "files/systemd/bb-worker.service",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tier = "integration",
)
