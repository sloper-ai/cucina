<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: FSL-1.1-ALv2 -->
<!-- bb_runner as a LaunchAgent in the build user's auto-login GUI (Aqua) session: some Xcode tools need a session.
     Installed outside /Library/LaunchAgents on purpose: hostd bootstraps it into gui/<uid> after pushing config
     (docs/dev/hostd.md §1.2-1.3). One bb_runner serves both runner platforms (Xcode and generic arm64). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.sloper.cucina.bb-runner</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/cucina/bin/bb_runner</string>
		<string>/etc/cucina/bb/runner.json</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>65536</integer>
	</dict>
	<key>HardResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>524288</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/var/log/cucina/bb_runner.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/cucina/bb_runner.log</string>
</dict>
</plist>
