load("@rules_go//go:def.bzl", "go_library")
load("//bazel:tiers.bzl", "cucina_go_test")

go_library(
    name = "remote",
    srcs = [
        "forward.go",
        "host.go",
        "local.go",
        "remote.go",
        "scripts.go",
        "ssm.go",
    ],
    importpath = "github.com/sloper-ai/cucina/test/e2e/remote",
    visibility = ["//test/e2e:__subpackages__"],
    deps = [
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_config//:config",
        "@com_github_aws_aws_sdk_go_v2_service_ssm//:ssm",
        "@com_github_aws_aws_sdk_go_v2_service_ssm//types",
    ],
)

cucina_go_test(
    name = "remote_test",
    srcs = ["remote_test.go"],
    embed = [":remote"],
    # This suite exercises the documented POSIX local transport, not PowerShell.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tier = "integration",
    deps = ["@com_github_stretchr_testify//require"],
)
