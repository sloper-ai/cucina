load("@rules_go//go:def.bzl", "go_library")
load("//bazel:tiers.bzl", "cucina_go_test")

go_library(
    name = "remote",
    srcs = [
        "forward.go",
        "forward_process_other.go",
        "forward_process_posix.go",
        "forward_process_windows.go",
        "host.go",
        "local.go",
        "local_job.go",
        "process_notice_darwin.go",
        "process_notice_linux.go",
        "process_owner.go",
        "remote.go",
        "scripts.go",
        "ssm.go",
        "windows_job.go",
    ],
    importpath = "github.com/sloper-ai/cucina/test/e2e/remote",
    visibility = ["//test/e2e:__subpackages__"],
    deps = [
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_config//:config",
        "@com_github_aws_aws_sdk_go_v2_service_ssm//:ssm",
        "@com_github_aws_aws_sdk_go_v2_service_ssm//types",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:darwin": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:ios": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:windows": [
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

# gazelle:exclude windows_ownership_test.go

cucina_go_test(
    name = "windows_ownership_test",  # keep
    srcs = ["windows_ownership_test.go"],  # keep
    target_compatible_with = ["@platforms//os:windows"],
    tier = "integration",
    deps = [
        ":remote",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_ssm//:ssm",
        "@com_github_aws_aws_sdk_go_v2_service_ssm//types",
        "@com_github_stretchr_testify//require",
    ],
)

