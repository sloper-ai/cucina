load("@rules_go//go:def.bzl", "go_library")
load("//bazel:tiers.bzl", "cucina_go_test")

go_library(
    name = "bazelrun",
    srcs = [
        "abseil.go",
        "bazelrun.go",
    ],
    importpath = "github.com/sloper-ai/cucina/test/e2e/bazelrun",
    visibility = ["//test/e2e:__subpackages__"],
    deps = [
        "//test/e2e/collect/bep",
        "//test/e2e/collect/execlog",
        "//test/e2e/collect/profile",
        "//test/e2e/remote",
    ],
)

# gazelle:exclude abseil_test.go
# gazelle:exclude windows_wait_test.go

cucina_go_test(
    name = "windows_wait_test",  # keep
    srcs = ["windows_wait_test.go"],  # keep
    runfiles_env = {"BASELINE_PS1": "//test/e2e/abseil:local-baseline.ps1"},
    target_compatible_with = ["@platforms//os:windows"],
    tier = "integration",
    deps = [
        ":bazelrun",
        "//test/e2e/remote",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_ssm//:ssm",
        "@com_github_aws_aws_sdk_go_v2_service_ssm//types",
        "@com_github_stretchr_testify//require",
    ],
)

cucina_go_test(
    name = "abseil_test",  # keep
    srcs = ["abseil_test.go"],  # keep
    tier = "unit",
    deps = [
        ":bazelrun",
        "@com_github_stretchr_testify//require",
    ],
)

cucina_go_test(
    name = "bazelrun_test",
    srcs = ["bazelrun_test.go"],
    data = [
        "//test/e2e/collect/bep:testdata",
        "//test/e2e/collect/execlog:testdata",
        "//test/e2e/collect/profile:testdata",
