load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_binary(
    name = "e2e",
    embed = [":e2e_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_library(
    name = "e2e_lib",
    srcs = ["main.go"],
    importpath = "github.com/sloper-ai/cucina/test/e2e/cmd/e2e",
    visibility = ["//visibility:private"],
    deps = [
        "//test/e2e/harness",
        "//test/e2e/report",
        "//test/e2e/scenarios",
    ],
