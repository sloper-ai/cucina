load("@rules_go//go:def.bzl", "go_library")
load("//bazel:tiers.bzl", "cucina_go_test")

go_library(
    name = "scenarios",
    srcs = [
        "build.go",
        "canary.go",
        "cli.go",
        "common.go",
        "cross.go",
        "data.go",
        "dogfood.go",
        "faults.go",
        "mac.go",
        "ops.go",
        "registry.go",
        "security.go",
    ],
    importpath = "github.com/sloper-ai/cucina/test/e2e/scenarios",
    visibility = ["//test/e2e:__subpackages__"],
    deps = [
        "//internal/canary",
        "//internal/cost",
        "//slo",
        "//test/e2e/bazelrun",
        "//test/e2e/collect/awsinv",
        "//test/e2e/collect/bep",
        "//test/e2e/collect/execlog",
        "//test/e2e/collect/prom",
        "//test/e2e/collect/spend",
        "//test/e2e/harness",
        "//test/e2e/infra",
        "//test/e2e/nfr",
        "//test/e2e/remote",
        "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:execution",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

cucina_go_test(
    name = "scenarios_test",
    srcs = ["scenarios_test.go"],
    embed = [":scenarios"],
    tier = "unit",
    deps = [
        "//test/e2e/harness",
        "//test/e2e/nfr",
        "@com_github_stretchr_testify//require",
    ],
)
