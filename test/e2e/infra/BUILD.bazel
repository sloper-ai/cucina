load("@rules_go//go:def.bzl", "go_library")
load("//bazel:tiers.bzl", "cucina_go_test")

go_library(
    name = "infra",
    srcs = [
        "client.go",
        "infra.go",
        "kube.go",
    ],
    importpath = "github.com/sloper-ai/cucina/test/e2e/infra",
    visibility = ["//test/e2e:__subpackages__"],
    deps = [
        "//internal/ports",
        "//test/e2e/collect/awsinv",
        "//test/e2e/collect/prom",
        "//test/e2e/harness",
        "//test/e2e/remote",
        "@com_github_aws_aws_sdk_go_v2_config//:config",
        "@com_github_aws_aws_sdk_go_v2_service_ec2//:ec2",
    ],
)

cucina_go_test(
    name = "infra_test",
    srcs = ["client_test.go"],
    # ClientLogin's local fake executable uses the POSIX transport (ADR 1002).
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tier = "integration",
    deps = [
        ":infra",
        "//internal/fakes",
        "//internal/ports",
        "//test/e2e/harness",
        "//test/e2e/remote",
        "@com_github_stretchr_testify//require",
    ],
)
