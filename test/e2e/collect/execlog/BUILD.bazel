load("@rules_go//go:def.bzl", "go_library")
load("//bazel:tiers.bzl", "cucina_go_test")

filegroup(
    name = "testdata",
    srcs = glob(["testdata/**"]),
    visibility = ["//test/e2e:__subpackages__"],
)

go_library(
    name = "execlog",
    srcs = [
        "execlog.go",
        "summary.go",
    ],
    importpath = "github.com/sloper-ai/cucina/test/e2e/collect/execlog",
    visibility = ["//test/e2e:__subpackages__"],
    deps = [
        "//test/e2e/third_party/bazel/spawnpb",
        "@com_github_klauspost_compress//zstd",
        "@org_golang_google_protobuf//encoding/protodelim",
        "@org_golang_google_protobuf//types/known/durationpb",
    ],
)

cucina_go_test(
    name = "execlog_test",
    srcs = ["execlog_test.go"],
    data = glob(["testdata/**"]),
    embed = [":execlog"],
    tier = "unit",
    deps = ["@com_github_stretchr_testify//require"],
)
