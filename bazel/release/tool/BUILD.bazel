# cucina-release: builds and checks the release artifacts (ADR 0150, ADR 0151). Used by the
# rules in //bazel/release and, through `bazel run`, by release/*.sh and the release workflow.
load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel:tiers.bzl", "cucina_go_test")

go_library(
    name = "tool_lib",
    srcs = [
        "archive.go",
        "binfmt.go",
        "buildinfo.go",
        "chart.go",
        "dist.go",
        "main.go",
        "oci.go",
        "ocimeta.go",
        "verify.go",
        "xar.go",
    ],
    importpath = "github.com/sloper-ai/cucina/bazel/release/tool",
    visibility = ["//visibility:private"],
    deps = ["@in_yaml_go_yaml_v3//:yaml"],
)

go_binary(
    name = "tool",
    embed = [":tool_lib"],
    visibility = ["//visibility:public"],
)

# Pure cores: version policy, archives (credential-helper alias), values pinning.
cucina_go_test(
    name = "tool_test",
    srcs = ["tool_test.go"],  # keep
    embed = [":tool_lib"],
    tier = "unit",
    deps = ["@com_github_stretchr_testify//require"],
)

# Files: the real Homebrew template and finalize over temporary dists.
# keep
cucina_go_test(
    name = "files_test",
    timeout = "short",
    srcs = ["files_test.go"],
    embed = [":tool_lib"],
    runfiles_env = {"FORMULA_TEMPLATE": "//release:homebrew/cucinactl.rb.tmpl"},
    tier = "integration",
    deps = ["@com_github_stretchr_testify//require"],
)
