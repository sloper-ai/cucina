{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sloper-ai/cucina/cli/cucinactl/schemas/bazelrc.v1.schema.json",
  "title": "cucinactl bazelrc",
  "type": "object",
  "properties": {
    "schema": {
      "const": "bazelrc.v1"
    },
    "kind": {
      "enum": [
        "bazelrc",
        "build-file"
      ]
    },
    "text": {
      "type": "string"
    },
    "notes": {
      "description": "Actions the user must take besides pasting the text (also present as comments in it).",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "kind",
    "text",
    "notes"
  ],
  "additionalProperties": false
}
