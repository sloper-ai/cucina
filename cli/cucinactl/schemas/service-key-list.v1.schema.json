{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sloper-ai/cucina/cli/cucinactl/schemas/service-key-list.v1.schema.json",
  "title": "cucinactl keys list",
  "type": "object",
  "properties": {
    "schema": {
      "const": "service-key-list.v1"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key_id": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "created": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_used": {
            "type": [
              "string",
              "null"
            ]
          },
          "revoked": {
            "type": "boolean"
          }
        },
        "required": [
          "key_id",
          "account",
          "description",
          "created",
          "expires_at",
          "last_used",
          "revoked"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "keys"
  ],
  "additionalProperties": false
}
