# cucinactl: library (CLI, credential helper, bazelrc generator, management client
# for the TUI) + binary. `cucina-credential-helper` is the same binary under another
# name (argv[0] dispatch); release packaging adds the hardlink/copy.
load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rust//rust:defs.bzl", "rustfmt_test")
load("//bazel:tiers.bzl", "cucina_rust_test")
load("//bazel/release:stamp.bzl", "RUST_VERSION_ENV_FILES")

rust_library(
    name = "cucinactl_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    # include_str!: the real platform catalogs (ADR 0807).
    compile_data = [
        "//platforms:pools.json",
        "//platforms:targets.json",
    ],
    crate_name = "cucinactl",
    crate_root = "src/lib.rs",
    rustc_env_files = RUST_VERSION_ENV_FILES,
    stamp = -1,
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "cucinactl",
    srcs = ["src/main.rs"],
    visibility = ["//visibility:public"],
    deps = [":cucinactl_lib"],
)

rustfmt_test(
    name = "rustfmt_test",
    tags = ["tier-static"],
    targets = [
        ":cucinactl",
        ":cucinactl_lib",
    ],
)

# Library checks: catalog validation/compatibility, duration syntax and loopback binding.
cucina_rust_test(
    name = "lib_test",
    # The minimal schema-1 fixture is consumed only by #[cfg(test)].
    compile_data = ["data/targets.json"],
    crate = ":cucinactl_lib",
    tier = "unit",
    deps = all_crate_deps(normal_dev = True),
)

# Pure property test of .bazelrc generation (UC9, R-DATA-1, R-XPLAT-2(d)).
cucina_rust_test(
    name = "bazelrc_props_test",
    srcs = [
        "tests/bazelrc_props.rs",
    ] + glob(["tests/support/*.rs"]),
    crate_root = "tests/bazelrc_props.rs",
    data = ["testdata/bazel-9.2-flags.txt"],
    tier = "unit",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [":cucinactl_lib"],
)

# Process-level tests against in-process fakes on loopback (R-TEST-3/-5).
[cucina_rust_test(
    name = t + "_test",
    srcs = ["tests/%s.rs" % t] + glob(["tests/support/*.rs"]),
    crate_root = "tests/%s.rs" % t,
    data = [":cucinactl"] + glob(["schemas/*.json"]),
    env = {"CUCINACTL_BIN": "$(rootpath :cucinactl)"},
    tier = "integration",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [":cucinactl_lib"],
) for t in [
    "credential_helper",
    "exit_codes",
    "json_contracts",
    "login",
    # Private CA and HTTPS_PROXY for discovery, the STS and the management API (T10a).
    "tls_proxy",
    # `cucinactl tui` in a pseudo-terminal against the fake management server.
    "tui_pty",
    "watch_reconnect",
]]

# TUI key screens (R-CLI-4, R-TEST-6): insta snapshots read from the runfiles tree.
# Tests never write snapshots; update them with
# `INSTA_UPDATE=always cargo test -p cucinactl --test tui_snapshots` (or `cargo insta review`).
cucina_rust_test(
    name = "tui_snapshots_test",
    srcs = ["tests/tui_snapshots.rs"],
    # Same crate (= snapshot file prefix) name as under Cargo.
    crate_name = "tui_snapshots",
    crate_root = "tests/tui_snapshots.rs",
    data = glob(["tests/snapshots/tui_snapshots__*.snap"]),
    env = {
        "INSTA_UPDATE": "no",
        "INSTA_WORKSPACE_ROOT": ".",
    },
    # At compile time too: otherwise insta embeds env!("CARGO_MANIFEST_DIR"), an
    # absolute sandbox path that the rules_rs process wrapper rejects.
    rustc_env = {"INSTA_WORKSPACE_ROOT": "."},
    tier = "unit",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [":cucinactl_lib"],
)

# TUI reducer rules: destructive actions need an explicit yes; stale/resync.
cucina_rust_test(
    name = "tui_reducer_test",
    srcs = ["tests/tui_reducer.rs"],
    crate_root = "tests/tui_reducer.rs",
    tier = "unit",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [":cucinactl_lib"],
)
