# SPDX-License-Identifier: FSL-1.1-ALv2
# Root package: Gazelle, formatters/linters and the golden-update entry point.
# How-to: docs/dev/bazel.md.

load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")
load("@gazelle//:def.bzl", "gazelle")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# --- Gazelle (Go BUILD files are generated; run `bazel run //:gazelle`) -----
# gazelle:prefix github.com/sloper-ai/cucina
# gazelle:go_naming_convention import
# Generated *.pb.go files are checked in (cucina_proto_go); Gazelle treats
# them as ordinary Go sources instead of emitting go_proto_library rules.
# gazelle:go_generate_proto false
# Tests generated by Gazelle go through the tier macros (R-TEST-8h). Add
# `tier = "<tier>"` to every generated cucina_go_test; Gazelle keeps it.
# gazelle:map_kind go_test cucina_go_test //bazel:tiers.bzl
# gazelle:exclude .work
# gazelle:exclude cli
# gazelle:exclude third_party
gazelle(name = "gazelle")

exports_files(
    [
        "buf.yaml",
        "go.mod",
        "go.sum",
        "Cargo.toml",
        "Cargo.lock",
        ".gitleaks.toml",
        ".github/workflows/nightly.yml",
        "deny.toml",
        # Licence documents distributed by //release (ADR 0151).
        "LICENSE.md",
        "THIRD_PARTY_NOTICES.md",
        "rustfmt.toml",
    ],
    visibility = ["//visibility:public"],
)

# --- Goldens and checked-in generated code (R-TEST-8e) ----------------------
# Runs every write_source_files update target; CI never writes goldens.
sh_binary(
    name = "update_goldens",
    srcs = ["//tools:update-goldens.sh"],
)

# --- Starlark formatting/lint (static tier) ---------------------------------
_BUILDIFIER_EXCLUDES = [
    "./.git/*",
    "./.work/*",
    "./bazel-*",
    # Fragments appended to Abseil's MODULE.bazel (another workspace).
    "./test/e2e/abseil/*",
]

# `bazel run //:buildifier` formats and fixes lint in place.
buildifier(
    name = "buildifier",
    exclude_patterns = _BUILDIFIER_EXCLUDES,
    lint_mode = "fix",
    mode = "fix",
)

# `bazel test //:buildifier_check`: fails on unformatted files or lint warnings.
buildifier_test(
    name = "buildifier_check",
    exclude_patterns = _BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    mode = "diff",
    no_sandbox = True,
    tags = ["tier-static"],
    workspace = "//:MODULE.bazel",
)
