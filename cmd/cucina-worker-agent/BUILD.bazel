load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_go//go:def.bzl", "go_binary", "go_cross_binary", "go_library")
load("//bazel:tiers.bzl", "cucina_go_test")
load("//bazel/release:stamp.bzl", "go_version_x_defs")

# Worker OS/arch targets of the agent (pure Go, CGO_ENABLED=0): EC2 Linux x86_64 and
# Graviton, EC2 Windows, and macOS Tart VMs (`render` through `tart exec`).
AGENT_PLATFORMS = [
    "linux_amd64",
    "linux_arm64",
    "windows_amd64",
    "darwin_arm64",
]

go_library(
    name = "cucina-worker-agent_lib",
    srcs = ["main.go"],
    importpath = "github.com/sloper-ai/cucina/cmd/cucina-worker-agent",
    visibility = ["//visibility:private"],
    deps = [
        "//api/proto/cucina/v1:cucina",
        "//internal/ports",
        "//internal/workeragent",
        "//internal/workeragent/bootdata",
        "//internal/workeragent/hostos",
        "//internal/workeragent/imds",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_binary(
    name = "cucina-worker-agent",
    embed = [":cucina-worker-agent_lib"],
    visibility = ["//visibility:public"],
    x_defs = go_version_x_defs("main.version"),
)

cucina_go_test(
    name = "cucina-worker-agent_test",
    srcs = ["main_test.go"],
    embed = [":cucina-worker-agent_lib"],
    tier = "integration",
    deps = ["@com_github_stretchr_testify//require"],
)

[
    go_cross_binary(
        name = "cucina-worker-agent_" + platform,
        platform = "@rules_go//go/toolchain:" + platform,
        target = ":cucina-worker-agent",
    )
    for platform in AGENT_PLATFORMS
]

# The agent cross-compiles for every worker platform.
build_test(
    name = "cross_compile_test",
    tags = ["tier-static"],
    targets = [":cucina-worker-agent_" + platform for platform in AGENT_PLATFORMS],
)
