load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel:oci.bzl", "cucina_go_image")
load("//bazel:tiers.bzl", "cucina_go_test")
load("//bazel/release:stamp.bzl", "go_version_x_defs")

go_library(
    name = "cucina-controller_lib",
    srcs = [
        "crds.go",
        "main.go",
    ],
    importpath = "github.com/sloper-ai/cucina/cmd/cucina-controller",
    visibility = ["//visibility:private"],
    deps = [
        "//api/crds",
        "//internal/canary",
        "//internal/config",
        "//internal/controller",
        "//internal/proto",
        "@com_github_spf13_cobra//:cobra",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_sigs_controller_runtime//:controller-runtime",
        "@io_k8s_sigs_controller_runtime//pkg/client",
    ],
)

go_binary(
    name = "cucina-controller",
    embed = [":cucina-controller_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
    x_defs = go_version_x_defs(
        "github.com/sloper-ai/cucina/internal/controller.Version",
        commit_var = "github.com/sloper-ai/cucina/internal/controller.Commit",
    ),
)

# Multi-arch image (linux/amd64 + linux/arm64) on distroless static nonroot (R-BUILD-3). The STS
# runs from the same image (`cucina-controller sts`).
cucina_go_image(
    name = "image",
    binary = ":cucina-controller",
    repository = "ghcr.io/sloper-ai/cucina-controller",
    visibility = ["//visibility:public"],
)

cucina_go_test(
    name = "cucina-controller_test",
    srcs = ["main_test.go"],
    embed = [":cucina-controller_lib"],
    tier = "unit",
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
