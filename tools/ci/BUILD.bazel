# Policy checks (flake and quarantine rules, manual-check structure, ADR index) and the tests of the git hooks.
# See TESTING.md ("The Test-Change trailer", "Flaky tests and quarantine") and docs/testing/manual/README.md.

load("//bazel:tiers.bzl", "cucina_sh_test")

# The checks are POSIX shell and awk; Windows CI runs its own targets.
_NOT_WINDOWS = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

filegroup(
    name = "scripts",
    srcs = glob([
        "*.sh",
        "*.awk",
    ]),
    visibility = ["//visibility:public"],
)

# The hooks against throwaway repositories. Split by concern to fit the integration budget.
# (tools/ci/mutate-hooks.sh, which deletes every rule in turn and runs these suites, takes minutes and is run by hand.)
[
    cucina_sh_test(
        name = "githooks_%s_test" % suite.replace("-", "_"),
        timeout = "short",
        srcs = ["test-githooks.sh"],
        args = [suite],
        data = [
            ":scripts",
            "//.githooks:files",
            "//tools:gitleaks",
        ],
        env = {"CUCINA_GITLEAKS": "$(rootpath //tools:gitleaks)"},
        tags = ["no-remote-exec"],  # needs git on the executor
        target_compatible_with = _NOT_WINDOWS,
        tier = "integration",
    )
    for suite in [
        "commit-msg-policy",  # Test-Change acceptance/refusal through the real hook
        "commit-msg-robustness",  # trailer parsing and fail-closed behavior
        "commit-msg-environment",  # history, user configuration and large renames
        "rules-sources",  # source paths, goldens, Go/Rust skips
        "rules-build",  # test target visibility, tiers, removals and moves
        "rules-cases",  # net case/line removal and manual checklist deletion
        "pre-push-transport",  # outgoing ranges, gitleaks and scanner integration
        "pre-push-hygiene",  # identifier shapes, exceptions and fork/history behavior
    ]
]

# check-quarantine.sh, check-manual-tests.sh and adr-index.sh against fixture trees.
cucina_sh_test(
    name = "ci_scripts_test",
    timeout = "short",
    srcs = ["test-ci-scripts.sh"],
    args = ["policies"],  # all existing cases; new Git fixtures have their own executor requirement
    data = [":scripts"],
    target_compatible_with = _NOT_WINDOWS,
    tier = "integration",
)

cucina_sh_test(
    name = "ci_changes_test",
    timeout = "short",
    srcs = ["test-ci-scripts.sh"],
    args = ["changes"],
    data = [
        ":scripts",
        "//.githooks:files",
    ],
    tags = ["no-remote-exec"],  # needs git on the executor, like githooks_*_test
    target_compatible_with = _NOT_WINDOWS,
    tier = "integration",
)

# Public system-lane orchestration against local executable fixtures, never a cluster.
cucina_sh_test(
    name = "system_install_test",
    timeout = "short",
    srcs = ["test-system-install.sh"],
    data = [
        "system-install.py",
        "system_install_test.py",
        "//:.github/workflows/nightly.yml",
    ],
    tags = ["no-remote-exec"],  # Uses the CI/development host's Python standard library.
    target_compatible_with = _NOT_WINDOWS,
    tier = "integration",
)

# The real manual checklists have the structure TESTING.md requires.
cucina_sh_test(
    name = "manual_tests_check",
    srcs = ["check-manual-tests.sh"],
    data = [
        ":scripts",
        "//docs/testing/manual:files",
    ],
    target_compatible_with = _NOT_WINDOWS,
    tier = "static",
)
