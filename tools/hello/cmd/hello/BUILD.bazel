load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "hello_lib",
    srcs = ["main.go"],
    importpath = "github.com/sloper-ai/cucina/tools/hello/cmd/hello",
    visibility = ["//visibility:private"],
    deps = [
        "//tools/hello/greeter",
        "//tools/hello/hellopb",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "hello",
    embed = [":hello_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)
