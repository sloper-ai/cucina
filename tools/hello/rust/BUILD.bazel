# Rust slice of the build-system smoke test (R-BUILD-1): buffa messages and
# connect-rust stubs generated by cucina_proto_rust (checked in under gen/),
# rust_library/rust_binary/rust_test against @crates, rustfmt_test. Not a Cargo
# workspace member, so dependencies are explicit @crates labels.
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rust//rust:defs.bzl", "rustfmt_test")
load("//bazel:proto.bzl", "cucina_proto_rust")
load("//bazel:tiers.bzl", "cucina_rust_test")

# `bazel run //tools/hello/rust:hellopb_rs_gen_update` refreshes gen/{buffa,connect}.
cucina_proto_rust(
    name = "hellopb_rs_gen_update",
    out_dir = "gen",
    proto = "//tools/hello/hellopb:hellopb_proto",
)

rust_library(
    name = "hellopb_rs",
    srcs = ["hellopb.rs"] + glob(
        ["gen/**/*.rs"],
        allow_empty = True,  # before the first `bazel run :hellopb_rs_gen_update`
    ),
    crate_root = "hellopb.rs",
    deps = [
        "@crates//:buffa",
        "@crates//:buffa-types",
        "@crates//:connectrpc",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_library(
    name = "greeter",
    srcs = ["greeter.rs"],
    crate_name = "hello_greeter",
    deps = [
        ":hellopb_rs",
        "@crates//:connectrpc",
    ],
)

# Cross-build proof (from this Mac, hermetic LLVM):
#   bazel build //tools/hello/rust:hello_rs --platforms=@rules_rs//rs/platforms:x86_64-unknown-linux-musl
#   bazel build //tools/hello/rust:hello_rs --platforms=@rules_rs//rs/platforms:aarch64-unknown-linux-musl
#   bazel build //tools/hello/rust:hello_rs --platforms=@rules_rs//rs/platforms:x86_64-pc-windows-gnullvm
rust_binary(
    name = "hello_rs",
    srcs = ["main.rs"],
    deps = [
        ":greeter",
        ":hellopb_rs",
        "@crates//:buffa",
        "@crates//:connectrpc",
        "@crates//:rustls",
        "@crates//:tokio",
        "@crates//:zstd",
    ],
)

cucina_rust_test(
    name = "greeter_test",
    crate = ":greeter",
    tier = "unit",
    deps = [
        "@crates//:buffa",
        "@crates//:tokio",
    ],
)

cucina_rust_test(
    name = "aws_lc_test",
    srcs = ["aws_lc_test.rs"],
    tier = "unit",
    deps = [
        "@crates//:aws-lc-rs",
        "@crates//:rustls",
        "@crates//:zstd",
    ],
)

rustfmt_test(
    name = "rustfmt_test",
    tags = ["tier-static"],
    targets = [
        ":aws_lc_test",
        ":greeter",
        ":hello_rs",
    ],
)
