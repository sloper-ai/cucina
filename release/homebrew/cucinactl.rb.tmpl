# Homebrew formula for cucinactl {{VERSION}}, generated by the release workflow of
# https://github.com/{{REPOSITORY}} from release/homebrew/cucinactl.rb.tmpl (R-OPS-7, R-CLI-1).
# Do not edit it in the tap: the next release overwrites it.
class Cucinactl < Formula
  desc "CLI and TUI for Cucina, a managed Buildbarn for Bazel remote execution"
  homepage "https://github.com/{{REPOSITORY}}"
  version "{{VERSION}}"
  license "FSL-1.1-ALv2"

  on_macos do
    on_arm do
      url "{{URL_DARWIN_ARM64}}"
      sha256 "{{SHA256_DARWIN_ARM64}}"
    end
  end

  on_linux do
    on_intel do
      url "{{URL_LINUX_AMD64}}"
      sha256 "{{SHA256_LINUX_AMD64}}"
    end
    on_arm do
      url "{{URL_LINUX_ARM64}}"
      sha256 "{{SHA256_LINUX_ARM64}}"
    end
  end

  def install
    bin.install "cucinactl"
    # Bazel's credential helper is the same binary under another name (argv[0] dispatch,
    # R-AUTH-8): `--credential_helper=<host>=#{HOMEBREW_PREFIX}/bin/cucina-credential-helper`.
    (bin/"cucina-credential-helper").make_link(bin/"cucinactl")
    generate_completions_from_executable(bin/"cucinactl", "completions")
  end

  test do
    assert_match "cucinactl #{version}", shell_output("#{bin}/cucinactl --version")
    assert_match "cucina-credential-helper #{version}",
                 shell_output("#{bin}/cucina-credential-helper --version")
  end
end
